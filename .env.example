# 本地开发配置：cp .env.example .env
# 只在服务端读取；不要把真实密钥提交到 Git。

DATABASE_URL=postgres://common_room:common_room@127.0.0.1:5487/common_room
SESSION_SECRET=dev-only-secret-change-me
APP_ORIGIN=http://localhost:5273,http://localhost:5274
PUBLIC_SITE_URL=http://localhost:5273

# 国内模型（OpenAI 兼容接口）。留空时咖啡馆问答使用本地馆藏笔记。
# DeepSeek: https://api.deepseek.com  deepseek-chat
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat

# 发信方式：auto（配置了 SMTP_HOST 用 SMTP，否则只写日志）/ smtp / tencent_ses / log
MAIL_PROVIDER=auto

# 腾讯云邮件推送 SES（个人账号只能用模板 API 发信，模板见 deploy/ses-templates.md）
# 密钥请使用只授权 SES 发信（ses:SendEmail）的子账号
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
SES_REGION=ap-guangzhou
SES_FROM=
SES_REPLY_TO=
SES_TEMPLATE_REGISTER_CODE=
SES_TEMPLATE_RESET_CODE=
SES_TEMPLATE_REPLY_NOTICE=
SES_TEMPLATE_AUTHOR_NOTICE=

# SMTP 发信。留空时验证码和通知只输出到服务端日志。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 新提交、新申请的通知邮箱
AUTHOR_NOTIFY_EMAIL=
# 用这个邮箱注册的账号自动成为管理员
ADMIN_BOOTSTRAP_EMAIL=
