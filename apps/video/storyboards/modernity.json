      "scene": {
        "type": "artwork",
        "work": "olympia",
        "mode": "cover",
        "label": false,
        "camera": [
          {
            "cx": 0.26,
            "cy": 0.31,
            "zoom": 2.6
          },
          {
            "cx": 0.26,
            "cy": 0.32,
            "zoom": 2.25
