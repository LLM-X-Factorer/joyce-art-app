            "zoom": 1.06
          }
        ]
      },
      "narration": "1863年，马奈画了《奥林匹亚》。画里的裸体不再是神话里的维纳斯，而是巴黎的一位现代女性。"
    },
    {
      "id": "03",
      "scene": {
        "type": "artwork",
        "work": "olympia",
        "mode": "cover",
        "camera": [
          {
            "cx": 0.3,
            "cy": 0.4,
            "zoom": 1.15
          },
          {
            "cx": 0.26,
            "cy": 0.31,
            "zoom": 2.1
          }
        ],
        "highlight": {
          "x": 0.255,
          "y": 0.295,
          "r": 0.06,
          "label": "她的目光"
        }
      },
      "narration": "先看她的眼睛。她直直地看着你，没有躲进幻想里。你突然意识到，自己也是这场观看的一部分。"
    },
    {
      "id": "04",
      "scene": {
        "type": "artwork",
        "work": "olympia",
        "mode": "cover",
        "camera": [
