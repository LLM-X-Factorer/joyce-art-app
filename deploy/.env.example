# 复制为 deploy/.env 后填写。此文件只放在服务器上，不要提交到 Git。

# ---------- 域名与证书 ----------
SERVER_NAME=example.com
# 两种部署方式二选一：
# A. 服务器上已有 Nginx 负责 HTTPS（推荐多站点服务器）：TLS=off，容器只监听本机端口，
#    宿主机 Nginx 反向代理到 127.0.0.1:HTTP_PORT，示例见 deploy/host-nginx.conf.example
TLS=off
HTTP_BIND=127.0.0.1
HTTP_PORT=3040
# B. 容器自己提供 HTTPS（独占服务器）：取消下面两行注释，把证书放到 deploy/certs/，并删除上面 A 的三行
# TLS=on
# COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
# 构建页脚与协议页面用
ICP_NUMBER=
PSB_NUMBER=
OPERATOR_NAME=
CONTACT_EMAIL=

# false：关闭公众注册、登录入口、我的书房与提交给作者（网站以游客模式运行，后台仍可用）
ACCOUNTS_ENABLED=true

# ---------- 服务端 ----------
POSTGRES_PASSWORD=
# 至少 32 位随机字符串：openssl rand -hex 32
SESSION_SECRET=
APP_ORIGIN=https://example.com
PUBLIC_SITE_URL=https://example.com
# 仅在 TLS=off 调试时设为 false，否则浏览器不会保存登录 Cookie
COOKIE_SECURE=true

# 国内模型（OpenAI 兼容接口）。留空则问答使用本地馆藏笔记
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat

# 发信方式：auto（配置了 SMTP_HOST 用 SMTP，否则只写日志）/ smtp / tencent_ses / log
MAIL_PROVIDER=auto

# 腾讯云邮件推送 SES（个人账号只能用模板 API 发信，模板见 deploy/ses-templates.md）
# 密钥请使用只授权 SES 发信（ses:SendEmail）的子账号
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
SES_REGION=ap-guangzhou
SES_FROM=
SES_REPLY_TO=
SES_TEMPLATE_REGISTER_CODE=
SES_TEMPLATE_RESET_CODE=
SES_TEMPLATE_REPLY_NOTICE=
SES_TEMPLATE_AUTHOR_NOTICE=

# SMTP 发信（企业认证的腾讯云 SES、阿里云邮件推送、腾讯企业邮、QQ 邮箱授权码等）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

AUTHOR_NOTIFY_EMAIL=
ADMIN_BOOTSTRAP_EMAIL=

# ---------- 镜像源（国内服务器拉不到 Docker Hub 时改为可用的镜像加速地址） ----------
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
NPM_REGISTRY=https://registry.npmmirror.com
