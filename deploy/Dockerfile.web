# 用户端 + 管理后台静态文件，由 Nginx 提供，并反向代理 /api 到后端
ARG NODE_IMAGE=node:22-alpine
ARG NGINX_IMAGE=nginx:1.27-alpine

FROM ${NODE_IMAGE} AS build
ARG NPM_REGISTRY=https://registry.npmmirror.com
WORKDIR /repo
RUN npm install -g pnpm@9.15.9 --registry=${NPM_REGISTRY}
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
RUN pnpm config set registry ${NPM_REGISTRY} \
  && pnpm install --frozen-lockfile --filter "@common-room/web..." --filter "@common-room/admin..."
COPY packages/shared packages/shared
COPY apps/web apps/web
COPY apps/admin apps/admin
# 页脚备案号、协议中的运营者信息在构建时写入
ARG VITE_ICP_NUMBER=""
ARG VITE_PSB_NUMBER=""
ARG VITE_OPERATOR_NAME=""
ARG VITE_CONTACT_EMAIL=""
ARG VITE_ACCOUNTS_ENABLED="true"
ENV VITE_ICP_NUMBER=${VITE_ICP_NUMBER} VITE_PSB_NUMBER=${VITE_PSB_NUMBER} \
  VITE_OPERATOR_NAME=${VITE_OPERATOR_NAME} VITE_CONTACT_EMAIL=${VITE_CONTACT_EMAIL} \
  VITE_ACCOUNTS_ENABLED=${VITE_ACCOUNTS_ENABLED}
RUN pnpm --filter @common-room/web build && pnpm --filter @common-room/admin build

FROM ${NGINX_IMAGE}
COPY deploy/nginx/app.conf /etc/nginx/snippets/app.conf
COPY deploy/nginx/https.conf.template deploy/nginx/http.conf.template /etc/nginx/variants/
COPY deploy/nginx/05-select-template.sh /docker-entrypoint.d/05-select-template.sh
RUN chmod +x /docker-entrypoint.d/05-select-template.sh && rm -f /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
COPY --from=build /repo/apps/admin/dist /usr/share/nginx/html/admin
